# POSTGRES_USER=qdetect_dev
# POSTGRES_PASSWORD=devQdetect
# POSTGRES_DB=qdetect_db
# DATABASE_URL_C=postgresql+psycopg://qdetect_dev:devQdetect@db:5432/qdetect_db

# DATABASE_URL=postgresql+psycopg://postgres:qdetect@localhost:5433/qdetect

# From the root docker-compose.yml (staging_db -> host 5434, cache_db -> host 5433)
STAGING_DATABASE_URL=postgresql+psycopg://staging:qdetect@127.0.0.1:5434/qdetect_staging
CACHE_DATABASE_URL=postgresql+psycopg://cache:qdetect@127.0.0.1:5433/qdetect_cache

# ML model service (ML/service.py)
ML_SERVICE_URL=http://127.0.0.1:8001
# Model that scores batches: graphsage or qgnn
ML_MODEL=qgnn

# Start the transaction poller on app startup. When false, start it with
# POST /api/util/jobs/start.
AUTO_START_POLLER=false

